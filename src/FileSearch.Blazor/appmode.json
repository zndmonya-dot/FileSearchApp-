{
  // ============================================================
  // Panoleon 動作モード設定（FileSearch.Blazor.exe と同じフォルダ）
  // くわしい説明: docs/appmode設定.md
  // ============================================================

  // 【mode】この PC の役割（画面には出ません・裏設定）
  //   "admin"     … 管理者。インデックス再構築・設定変更ができる
  //   "reference" … 利用者。検索とプレビューのみ（設定変更・再構築は不可）
  "mode": "admin",

  // 【sharedConfig】全員共通の設定ファイル（ファイルサーバ上の UNC パス）
  //   中身: インデックスの場所 + 検索対象フォルダ（shared.json を参照）
  //   管理者が設定画面で「保存」すると、このファイルが自動更新される
  //   利用者はアプリ起動時にここを読む（再起動で最新に追従）
  //
  // 開発時（1台だけで試すとき）は、この行をコメントアウトしてよい
  // "sharedConfig": "\\\\fileserver\\panoleon\\shared.json"
}
