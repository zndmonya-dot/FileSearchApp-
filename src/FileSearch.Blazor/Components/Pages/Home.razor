@page "/"
@*
  メイン画面のマークアップ。状態・処理は Home.razor.cs / Home.*.cs の partial。
*@
@using FullTextSearch.Core.Index
@using FullTextSearch.Core.Search
@using FullTextSearch.Core.Models
@using FullTextSearch.Core.Extractors
@using FullTextSearch.Infrastructure.Settings
@using FileSearch.Blazor.Components.Shared
@using Microsoft.Extensions.Logging
@inject ISearchService SearchService
@inject IIndexService IndexService
@inject IAppSettingsService SettingsService
@inject IAppModeService AppMode
@inject FullTextSearch.Core.Preview.IPreviewService PreviewService
@inject FileSearch.Blazor.Services.PreviewJsInterop PreviewJs
@inject IJSRuntime JSRuntime
@inject ILogger<Home> Logger
@inject IEnumerable<ITextExtractor> TextExtractors

<div class="app @(isDarkMode ? "dark" : "light")">
    <div class="app-container">
        <SearchSidebar SidebarWidth="sidebarWidth"
                      SearchQuery="@searchQuery"
                      SearchQueryChanged="OnSearchQueryChangedAsync"
                      SearchMode="searchMode"
                      SearchModeChanged="OnSearchModeChangedAsync"
                      TreeNodes="treeNodes"
                      CurrentPreviewFilePath="@GetTreeHighlightFilePath()"
                      CurrentFolderPath="@(selectedFolder?.FullPath)"
                      HasSearchedCurrentQuery="@HasSearchedCurrentQuery"
                      IsSearchActive="@(_lastExecutedSearchQuery != null)"
                      IsBrowseMode="@(_lastExecutedSearchQuery == null)"
                      HasTargetFolders="@HasActiveTargetFolders"
                      NoTargetFoldersMessage="@(SettingsService.Settings.TargetFolders.Count > 0 ? UserMessages.NoActiveTargetFolders : UserMessages.NoTargetFolders)"
                      IsLoadingFolderTree="isLoadingFolderTree"
                      IsSearching="isSearching"
                      SearchErrorMessage="@searchErrorMessage"
                      IsIndexing="isIndexing"
                      IndexCount="indexCount"
                      IndexProgressPercent="indexProgressPercent"
                      IndexProgressText="@indexProgressText"
                      IndexProgressDetail="@indexProgressDetail"
                      IndexProgressEtaHint="@indexProgressEtaHint"
                      IndexErrorMessage="@indexErrorMessage"
                      IndexSkipCount="indexSkipCount"
                      OnSearch="ExecuteSearch"
                      OnSearchKeyDown="HandleKeyDown"
                      OnSearchInputChanged="OnSearchInputChanged"
                      OnToggleNode="ToggleNode"
                      OnSelectFolder="SelectFolderFromTree"
                      OnSelectFile="SelectFileFromTree"
                      GetFileIconClass="DisplayFormatters.GetFileIconClass"
                      OnRequestRebuildIndex="RequestRebuildIndex"
                      OnCancelIndexBuild="CancelIndexBuild"
                      OnStartResize="StartResize"
                      GetLastUpdateText="GetLastUpdateText"
                      IsAdmin="isAdmin"
                      OnOpenSettings="OpenSettings"
                      OnOpenSkippedLog="OpenSkippedLog" />

        @* M-07 右メイン領域（プレビュー優先 → フォルダ一覧 → 空状態） *@
        <main class="main-content @(isIndexing ? "main-content--locked" : null)">
            @if (selectedFile != null)
            {
                <FilePreviewView SelectedFile="selectedFile"
                                 FolderPathSegments="@GetPreviewFolderPathSegments()"
                                 IsLoadingPreview="isLoadingPreview"
                                 Preview="_previewResult"
                                 ShowNavButtons="ShowNavButtons"
                                 OnPreviewRendered="HandlePreviewRendered"
                                 OnGoPrev="GoPrev"
                                 OnGoNext="GoNext"
                                 OnOpenFile="OpenFile"
                                 OnOpenFolder="OpenFolder"
                                 OnNavigateToFolderPath="NavigateToFolderFromPreview"
                                 GetFileIconClass="DisplayFormatters.GetFileIconClass" />
            }
            else if (selectedFolder != null)
            {
                var folderFiles = GetFilesUnderSelectedFolder(selectedFolder);
                var filteredFolderFiles = GetFilteredFolderList(selectedFolder);
                <FolderListView SelectedFolder="selectedFolder"
                               SortedAndFilteredItems="filteredFolderFiles"
                               AllFileItems="folderFiles"
                               TotalFileCount="folderFiles.Count"
                               FilteredFileCount="filteredFolderFiles.Count"
                               SelectedRowIndex="selectedFolderRowIndex"
                               @bind-FileSearchQuery="folderFileSearchQuery"
                               @bind-FileSearchQuery:after="OnFolderFileSearchQueryChanged"
                               SortColumn="sortColumn"
                               SortAscending="sortAscending"
                               FilterType="filterType"
                               ShowFilterMenu="showFilterMenu"
                               ScrollToRowIndex="_folderListScrollToRow"
                               OnScrollToRowCompleted="OnFolderListScrollCompleted"
                               OnSort="SetSort"
                               OnToggleFilterMenu="ToggleFilterMenu"
                               OnCloseFilterMenu="CloseFilterMenu"
                               OnFilter="SetFilter"
                               OnRowClick="OnFolderRowClick"
                               OnNavigateToFolder="NavigateToFolder"
                               GetFileIconClass="DisplayFormatters.GetFileIconClass" />
            }
            else if (!HasActiveTargetFolders)
            {
                @* M-10 対象フォルダ未設定 *@
                <div class="empty-state empty-state-blankslate">
                    <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M.513 1.513A1.75 1.75 0 0 1 1.75 1h3.5c.55 0 1.07.26 1.4.7l.9 1.2a.25.25 0 0 0 .2.1H13a1 1 0 0 1 1 1v.5H2.75a.75.75 0 0 0 0 1.5h11.978a1 1 0 0 1 .994 1.117L15 13.25A1.75 1.75 0 0 1 13.25 15H1.75A1.75 1.75 0 0 1 0 13.25V2.75c0-.464.184-.91.513-1.237Z"/></svg>
                    <h3>@(SettingsService.Settings.TargetFolders.Count > 0 ? UserMessages.NoActiveTargetFolders : UserMessages.NoTargetFolders)</h3>
                    <p>@UserMessages.EmptyMainNoFoldersHint</p>
                </div>
            }
            else
            {
                @* M-10 ファイル未選択（検索後・閲覧時） *@
                <div class="empty-state empty-state-blankslate">
                    <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M2 1.75C2 .784 2.784 0 3.75 0h6.586c.464 0 .909.184 1.237.513l2.914 2.914c.329.328.513.773.513 1.237v9.586A1.75 1.75 0 0 1 13.25 16h-9.5A1.75 1.75 0 0 1 2 14.25Zm1.75-.25a.25.25 0 0 0-.25.25v12.5c0 .138.112.25.25.25h9.5a.25.25 0 0 0 .25-.25V6h-2.75A1.75 1.75 0 0 1 9 4.25V1.5Zm6.75.062V4.25c0 .138.112.25.25.25h2.688l-.011-.013-2.914-2.914-.013-.011Z"/></svg>
                    <h3>@UserMessages.EmptyMainSelectFileTitle</h3>
                    <p>@UserMessages.EmptyMainSelectFileHint</p>
                </div>
            }
        </main>
    </div>

    <IndexUpdateDialog Visible="_showRebuildConfirm"
                       FullRebuildSelected="_indexUpdateFullRebuild"
                       FullRebuildSelectedChanged="OnIndexUpdateModeChanged"
                       OnConfirm="ConfirmIndexUpdateAsync"
                       OnCancel="CancelRebuildConfirm" />

    <SettingsModal Visible="showSettings && !isIndexing"
                   State="_settingsEdit"
                   IsAdmin="isAdmin"
                   AvailableExtensions="BuildAvailableExtensions()"
                   LastIndexUpdate="SettingsService.Settings.LastIndexUpdate"
                   OnCloseRequested="CloseSettings"
                   OnSaveRequested="SaveSettings"
                   OnBrowseFolder="HandleBrowseFolder"
                   OnRemoveFolder="RemoveFolder"
                   OnBrowseIndexPath="HandleBrowseIndexPath"
                   OnToggleTargetExtension="HandleToggleTargetExtension" />
</div>

@if (isResizing)
{
    <div class="resize-overlay" @onmousemove="OnResize" @onmouseup="StopResize" @onmouseleave="StopResize"></div>
}
