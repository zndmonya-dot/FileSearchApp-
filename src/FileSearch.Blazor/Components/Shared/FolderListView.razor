@namespace FileSearch.Blazor.Components.Shared
@*
  選択フォルダ配下の子一覧（GitHub リポジトリブラウザ風: パンくず + 名前/内容/更新日時）。
*@
@using FileSearch.Blazor.Components.Shared
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@inject IJSRuntime Js
@if (SelectedFolder != null)
{
<div class="file-box folder-browser">
    <div class="folder-browser-header">
        <nav class="folder-breadcrumb" aria-label="@UserMessages.FolderListBreadcrumbLabel">
            @foreach (var (segment, index) in GetBreadcrumb().Select((s, i) => (s, i)))
            {
                @if (index > 0)
                {
                    <span class="folder-breadcrumb-sep" aria-hidden="true">/</span>
                }
                @if (segment == SelectedFolder)
                {
                    <span class="folder-breadcrumb-current" title="@segment.FullPath">@segment.Name</span>
                }
                else
                {
                    <button type="button"
                            class="folder-breadcrumb-link"
                            title="@segment.FullPath"
                            @onclick="() => OnNavigateToFolder.InvokeAsync(segment)">
                        @segment.Name
                    </button>
                }
            }
        </nav>
        <div class="folder-browser-toolbar">
            <span class="folder-browser-count">@UserMessages.FormatChildCount(SelectedFolder.Children?.Count ?? 0)</span>
            <div class="filter-dropdown">
                <button class="filter-btn @(string.IsNullOrEmpty(FilterType) ? "" : "active")"
                        @onclick="OnToggleFilterMenu"
                        @onclick:stopPropagation="true"
                        title="@UserMessages.FilterTitle">
                    <svg viewBox="0 0 16 16" fill="currentColor"><path d="M.75 3h14.5a.75.75 0 0 1 0 1.5H.75a.75.75 0 0 1 0-1.5ZM3 7.75A.75.75 0 0 1 3.75 7h8.5a.75.75 0 0 1 0 1.5h-8.5A.75.75 0 0 1 3 7.75Zm3 4a.75.75 0 0 1 .75-.75h2.5a.75.75 0 0 1 0 1.5h-2.5a.75.75 0 0 1-.75-.75Z"/></svg>
                </button>
                @if (ShowFilterMenu && SelectedFolder.Children != null)
                {
                    <div class="filter-menu" @onclick:stopPropagation="true">
                        <div class="filter-option @(FilterType == "" ? "selected" : "")" @onclick='() => OnFilter.InvokeAsync("")'>@UserMessages.FilterAll</div>
                        @if (SelectedFolder.Children.Any(c => c.IsFolder))
                        {
                            <div class="filter-option @(FilterType == "folder" ? "selected" : "")" @onclick='() => OnFilter.InvokeAsync("folder")'>@UserMessages.KindFolder</div>
                        }
                        @foreach (var ext in GetUniqueExtensions())
                        {
                            <div class="filter-option @(FilterType == ext ? "selected" : "")" @onclick="() => OnFilter.InvokeAsync(ext)">@ext.ToUpperInvariant()</div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
    <div id="folder-list" class="folder-list">
        @if (_isColumnResizing)
        {
            <div class="folder-col-resize-overlay"
                 @onmousemove="OnColumnResize"
                 @onmouseup="StopColumnResize"
                 @onmouseleave="StopColumnResize"></div>
        }
        <table @ref="_tableRef" class="folder-table @(_isColumnResizing ? "folder-table--resizing" : null)">
            <colgroup>
                @if (_columnLayoutInitialized)
                {
                    <col style="width: @($"{_colNameWidth}px")" />
                    <col style="width: @($"{_colPreviewWidth}px")" />
                    <col style="width: @($"{GetColDateWidth()}px")" />
                }
                else
                {
                    @* 測定前: 日時列を先に確保し、残りを名前・内容へ（固定px合計で日時が消えるのを防ぐ） *@
                    <col style="width: 24%" />
                    <col />
                    <col style="width: @($"{ColDateDefault}px")" />
                }
            </colgroup>
            <thead>
                <tr>
                    <th class="col-name sortable @(SortColumn == "name" ? "sorted" : "")" @onclick='() => OnSort.InvokeAsync("name")'>
                        <span class="col-header-label">@UserMessages.ColumnName @GetSortIcon("name")</span>
                        <span class="resize-handle @GetColumnResizeActiveClass(FolderTableColumn.Name)"
                              title="@UserMessages.ColumnResizeHandleTitle"
                              @onmousedown="@(e => StartColumnResizeAsync(e, FolderTableColumn.Name))"
                              @onmousedown:stopPropagation="true"
                              @onclick:stopPropagation="true"></span>
                    </th>
                    <th class="col-preview sortable @(SortColumn == "preview" ? "sorted" : "")" @onclick='() => OnSort.InvokeAsync("preview")'>
                        <span class="col-header-label">@UserMessages.ColumnPreview @GetSortIcon("preview")</span>
                        <span class="resize-handle @GetColumnResizeActiveClass(FolderTableColumn.Preview)"
                              title="@UserMessages.ColumnResizeHandleTitle"
                              @onmousedown="@(e => StartColumnResizeAsync(e, FolderTableColumn.Preview))"
                              @onmousedown:stopPropagation="true"
                              @onclick:stopPropagation="true"></span>
                    </th>
                    <th class="col-date sortable @(SortColumn == "date" ? "sorted" : "")" @onclick='() => OnSort.InvokeAsync("date")'>
                        <span class="col-header-label">@UserMessages.ColumnDate @GetSortIcon("date")</span>
                    </th>
                </tr>
            </thead>
            <tbody>
                @if (SelectedFolder.Children != null)
                {
                    var folderListItems = SortedAndFilteredItems.ToList();
                    @for (var i = 0; i < folderListItems.Count; i++)
                    {
                        var item = folderListItems[i];
                        var previewText = GetContentPreview(item);
                        <tr class="folder-row @(i == SelectedRowIndex ? "selected" : "")" @onclick="async () => { await OnRowClick.InvokeAsync(item); }">
                            <td class="col-name">
                                <span class="col-name-cell">
                                    @if (item.IsFolder)
                                    {
                                        <svg class="item-icon folder" viewBox="0 0 16 16" fill="currentColor"><path d="M.513 1.513A1.75 1.75 0 0 1 1.75 1h3.5c.55 0 1.07.26 1.4.7l.9 1.2a.25.25 0 0 0 .2.1H13a1 1 0 0 1 1 1v.5H2.75a.75.75 0 0 0 0 1.5h11.978a1 1 0 0 1 .994 1.117L15 13.25A1.75 1.75 0 0 1 13.25 15H1.75A1.75 1.75 0 0 1 0 13.25V2.75c0-.464.184-.91.513-1.237Z"/></svg>
                                    }
                                    else
                                    {
                                        <svg class="item-icon file" viewBox="0 0 16 16" fill="currentColor"><path d="M2 1.75C2 .784 2.784 0 3.75 0h6.586c.464 0 .909.184 1.237.513l2.914 2.914c.329.328.513.773.513 1.237v9.586A1.75 1.75 0 0 1 13.25 16h-9.5A1.75 1.75 0 0 1 2 14.25Zm1.75-.25a.25.25 0 0 0-.25.25v12.5c0 .138.112.25.25.25h9.5a.25.25 0 0 0 .25-.25V6h-2.75A1.75 1.75 0 0 1 9 4.25V1.5Zm6.75.062V4.25c0 .138.112.25.25.25h2.688l-.011-.013-2.914-2.914-.013-.011Z"/></svg>
                                    }
                                    <span class="item-name">@item.Name</span>
                                </span>
                            </td>
                            <td class="col-preview">
                                @if (previewText != null)
                                {
                                    <span class="item-content-preview" title="@previewText">@previewText</span>
                                }
                            </td>
                            <td class="col-date">@(item.LastModified.HasValue ? DisplayFormatters.FormatDate(item.LastModified.Value) : "-")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
}

@code {
    [Parameter] public TreeNode? SelectedFolder { get; set; }
    [Parameter] public IEnumerable<TreeNode> SortedAndFilteredItems { get; set; } = Enumerable.Empty<TreeNode>();
    [Parameter] public string SortColumn { get; set; } = "name";
    [Parameter] public bool SortAscending { get; set; } = true;
    [Parameter] public string FilterType { get; set; } = "";
    [Parameter] public bool ShowFilterMenu { get; set; }
    [Parameter] public int SelectedRowIndex { get; set; }
    [Parameter] public EventCallback<string> OnSort { get; set; }
    [Parameter] public EventCallback OnToggleFilterMenu { get; set; }
    [Parameter] public EventCallback<string> OnFilter { get; set; }
    [Parameter] public EventCallback<TreeNode> OnRowClick { get; set; }
    [Parameter] public EventCallback<TreeNode> OnNavigateToFolder { get; set; }
    [Parameter] public IReadOnlyDictionary<string, string>? FileContentPreviews { get; set; }

    private enum FolderTableColumn { Name, Preview, Date }

    private const int ColNameDefault = 280;
    private const int ColPreviewDefault = 480;
    private const int ColMinName = 96;
    private const int ColMinPreview = 80;
    private const int ColDateDefault = 136;
    private const int ColMinDate = 112;
    private const int ColMaxDate = 168;
    private const int ColMax = 640;

    private ElementReference _tableRef;
    private int _tableWidth;
    private int _colNameWidth = ColMinName;
    private int _colPreviewWidth = ColMinPreview;
    private int _colDateWidth = ColDateDefault;
    private bool _columnLayoutInitialized;
    private bool _isColumnResizing;
    private FolderTableColumn _resizeColumn;
    private double _columnResizeStartX;
    private int _columnResizeStartPrimary;
    private int _columnResizeStartSecondary;

    private List<TreeNode> GetBreadcrumb()
    {
        var list = new List<TreeNode>();
        for (var node = SelectedFolder; node != null; node = node.Parent)
            list.Add(node);
        list.Reverse();
        return list;
    }

    private string? GetContentPreview(TreeNode item)
    {
        if (item.IsFolder || string.IsNullOrEmpty(item.FilePath) || FileContentPreviews == null)
            return null;
        return FileContentPreviews.TryGetValue(item.FilePath, out var preview) && !string.IsNullOrEmpty(preview)
            ? preview
            : null;
    }

    private IEnumerable<string> GetUniqueExtensions()
    {
        if (SelectedFolder?.Children == null)
            return Enumerable.Empty<string>();
        return SelectedFolder.Children
            .Where(i => !i.IsFolder && !string.IsNullOrEmpty(Path.GetExtension(i.Name)))
            .Select(i => Path.GetExtension(i.Name).ToLowerInvariant())
            .Distinct()
            .OrderBy(e => e);
    }

    private MarkupString GetSortIcon(string column)
    {
        if (SortColumn != column)
            return new MarkupString("");
        return new MarkupString(SortAscending
            ? "<svg class='sort-icon' viewBox='0 0 16 16' fill='currentColor'><path d='m4.427 7.427 3.396 3.396a.25.25 0 0 0 .354 0l3.396-3.396A.25.25 0 0 0 11.396 7H4.604a.25.25 0 0 0-.177.427Z'/></svg>"
            : "<svg class='sort-icon' viewBox='0 0 16 16' fill='currentColor'><path d='m4.427 9.573 3.396-3.396a.25.25 0 0 1 .354 0l3.396 3.396a.25.25 0 0 1-.177.427H4.604a.25.25 0 0 1-.177-.427Z'/></svg>");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (SelectedFolder == null || _columnLayoutInitialized)
            return;

        await RefreshTableWidthAsync();
        if (_tableWidth <= 0)
            return;

        EnsureInitialColumnLayout();
        NormalizeColumnWidths();
        StateHasChanged();
    }

    /// <summary>初回のみ、日時列を狭く・名前／内容に残り幅を配分する。</summary>
    private void EnsureInitialColumnLayout()
    {
        if (_columnLayoutInitialized || _tableWidth <= 0)
            return;

        _colDateWidth = ColDateDefault;
        var available = _tableWidth - _colDateWidth;
        if (available < ColMinName + ColMinPreview)
        {
            _colNameWidth = ColMinName;
            _colPreviewWidth = Math.Max(ColMinPreview, available - ColMinName);
        }
        else
        {
            _colNameWidth = Math.Max(ColMinName, available * 28 / 100);
            _colPreviewWidth = Math.Max(ColMinPreview, available - _colNameWidth);
        }

        _columnLayoutInitialized = true;
    }

    private async Task RefreshTableWidthAsync()
    {
        try
        {
            _tableWidth = await Js.InvokeAsync<int>("getElementClientWidth", _tableRef).ConfigureAwait(false);
        }
        catch (JSException)
        {
            _tableWidth = 0;
        }
    }

    private async Task StartColumnResizeAsync(MouseEventArgs e, FolderTableColumn column)
    {
        await RefreshTableWidthAsync().ConfigureAwait(false);
        if (_tableWidth > 0)
            NormalizeColumnWidths();

        _isColumnResizing = true;
        _resizeColumn = column;
        _columnResizeStartX = e.ClientX;
        _columnResizeStartPrimary = GetColumnWidth(column);
        _columnResizeStartSecondary = column switch
        {
            FolderTableColumn.Name => _colPreviewWidth,
            FolderTableColumn.Preview => GetColDateWidth(),
            _ => 0,
        };
    }

    private void OnColumnResize(MouseEventArgs e)
    {
        if (!_isColumnResizing)
            return;

        var delta = (int)(e.ClientX - _columnResizeStartX);
        switch (_resizeColumn)
        {
            case FolderTableColumn.Name:
            {
                var (name, preview) = ResizePair(
                    _columnResizeStartPrimary, _columnResizeStartSecondary, delta,
                    ColMinName, ColMinPreview, capSecondaryAtColMax: true);
                ApplyNamePreviewWidths(name, preview);
                break;
            }
            case FolderTableColumn.Preview:
            {
                var (preview, date) = ResizePair(
                    _columnResizeStartPrimary, _columnResizeStartSecondary, delta,
                    ColMinPreview, ColMinDate, capSecondaryAtColMax: false);
                _colPreviewWidth = preview;
                _colDateWidth = Math.Clamp(date, ColMinDate, ColMaxDate);
                break;
            }
        }
    }

    private void StopColumnResize(MouseEventArgs _) => _isColumnResizing = false;

    private int GetColDateWidth() => _colDateWidth;

    private void ApplyNamePreviewWidths(int name, int preview)
    {
        if (_tableWidth > 0)
        {
            var maxPair = _tableWidth - _colDateWidth;
            if (name + preview > maxPair)
            {
                preview = Math.Max(ColMinPreview, maxPair - name);
                name = Math.Max(ColMinName, maxPair - preview);
            }
        }

        _colNameWidth = name;
        _colPreviewWidth = preview;
    }

    private void NormalizeColumnWidths()
    {
        if (_tableWidth <= 0)
            return;

        _colDateWidth = Math.Clamp(_colDateWidth, ColMinDate, ColMaxDate);
        var maxPair = _tableWidth - _colDateWidth;
        if (maxPair <= ColMinName + ColMinPreview)
        {
            _colNameWidth = ColMinName;
            _colPreviewWidth = Math.Max(ColMinPreview, maxPair - ColMinName);
            return;
        }

        if (_colNameWidth + _colPreviewWidth > maxPair)
        {
            var sum = _colNameWidth + _colPreviewWidth;
            _colNameWidth = Math.Max(ColMinName, (int)((long)_colNameWidth * maxPair / sum));
            _colPreviewWidth = Math.Max(ColMinPreview, maxPair - _colNameWidth);
            if (_colNameWidth + _colPreviewWidth > maxPair)
                _colPreviewWidth = maxPair - _colNameWidth;
            return;
        }

        // 余白は内容列へ（名前・内容を広く、日時は固定幅のまま）
        _colPreviewWidth = maxPair - _colNameWidth;
    }

    /// <summary>隣接2列の合計幅を保ったまま境界を動かす。</summary>
    private static (int Primary, int Secondary) ResizePair(
        int startPrimary, int startSecondary, int delta,
        int minPrimary, int minSecondary, bool capSecondaryAtColMax)
    {
        var total = startPrimary + startSecondary;
        var maxPrimary = Math.Min(ColMax, total - minSecondary);
        var primary = Math.Clamp(startPrimary + delta, minPrimary, maxPrimary);
        var secondary = total - primary;
        if (secondary < minSecondary)
        {
            secondary = minSecondary;
            primary = total - secondary;
        }
        else if (capSecondaryAtColMax && secondary > ColMax)
        {
            secondary = ColMax;
            primary = total - secondary;
        }

        primary = Math.Clamp(primary, minPrimary, maxPrimary);
        secondary = Math.Clamp(secondary, minSecondary, total - minPrimary);
        return (primary, secondary);
    }

    private string? GetColumnResizeActiveClass(FolderTableColumn column) =>
        _isColumnResizing && _resizeColumn == column ? "resize-handle--active" : null;

    private int GetColumnWidth(FolderTableColumn column) => column switch
    {
        FolderTableColumn.Name => _colNameWidth,
        FolderTableColumn.Preview => _colPreviewWidth,
        _ => ColNameDefault,
    };
}
