@namespace FileSearch.Blazor.Components.Shared
@*
  選択フォルダ配下のファイル一覧（パンくず + 名前・更新日時）。
*@
@using FullTextSearch.Core.UI
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@inject IJSRuntime Js
@if (SelectedFolder != null)
{
<div class="file-box folder-browser">
    <div class="folder-browser-header">
        <nav class="folder-breadcrumb" aria-label="@UserMessages.FolderListBreadcrumbLabel">
            @foreach (var (segment, index) in GetBreadcrumb().Select((s, i) => (s, i)))
            {
                @if (index > 0)
                {
                    <span class="folder-breadcrumb-sep" aria-hidden="true">/</span>
                }
                @if (segment == SelectedFolder)
                {
                    <span class="folder-breadcrumb-current" title="@FolderListDisplay.NormalizeDisplayPath(segment.FullPath)">@segment.Name</span>
                }
                else
                {
                    <button type="button"
                            class="folder-breadcrumb-link"
                            title="@FolderListDisplay.NormalizeDisplayPath(segment.FullPath)"
                            @onclick="() => OnNavigateToFolder.InvokeAsync(segment)">
                        @segment.Name
                    </button>
                }
            }
        </nav>
        <div class="folder-browser-toolbar">
            <span class="folder-browser-count">@UserMessages.FormatFilteredChildCount(FilteredFileCount, TotalFileCount)</span>
            <div class="filter-dropdown">
                @if (ShowFilterMenu)
                {
                    <div class="filter-menu-backdrop" @onclick="CloseFilterMenu"></div>
                }
                <button type="button"
                        class="filter-btn @(string.IsNullOrEmpty(FilterType) ? "" : "active")"
                        @onclick="OnToggleFilterMenu"
                        @onclick:stopPropagation="true"
                        aria-expanded="@ShowFilterMenu"
                        aria-haspopup="true"
                        title="@UserMessages.FilterTitle"
                        aria-label="@UserMessages.FilterTitle">
                    <svg viewBox="0 0 16 16" fill="currentColor"><path d="M.75 3h14.5a.75.75 0 0 1 0 1.5H.75a.75.75 0 0 1 0-1.5ZM3 7.75A.75.75 0 0 1 3.75 7h8.5a.75.75 0 0 1 0 1.5h-8.5A.75.75 0 0 1 3 7.75Zm3 4a.75.75 0 0 1 .75-.75h2.5a.75.75 0 0 1 0 1.5h-2.5a.75.75 0 0 1-.75-.75Z"/></svg>
                </button>
                @if (ShowFilterMenu)
                {
                    <div class="filter-menu" @onclick:stopPropagation="true">
                        <div class="filter-option @(FilterType == "" ? "selected" : "")" @onclick='() => OnFilter.InvokeAsync("")'>@UserMessages.FilterAll</div>
                        @foreach (var ext in GetUniqueExtensions())
                        {
                            <div class="filter-option @(FilterType == ext ? "selected" : "")" @onclick="() => OnFilter.InvokeAsync(ext)">@ext.ToUpperInvariant()</div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="folder-browser-search">
        <svg class="folder-browser-search-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M10.68 11.74a6 6 0 0 1-7.922-8.982 6 6 0 0 1 8.982 7.922l3.04 3.04a.749.749 0 0 1-.326 1.275.749.749 0 0 1-.734-.215ZM11.5 7a4.499 4.499 0 1 0-8.997 0A4.499 4.499 0 0 0 11.5 7Z"/></svg>
        <input type="search"
               class="folder-browser-search-input"
               placeholder="@UserMessages.FolderListFileSearchPlaceholder"
               aria-label="@UserMessages.FolderListFileSearchPlaceholder"
               autocomplete="off"
               @bind="FileSearchQueryValue"
               @bind:event="oninput" />
    </div>
    <div id="folder-list" class="folder-list">
        @if (_isColumnResizing)
        {
            <div class="folder-col-resize-overlay"
                 @onmousemove="OnColumnResize"
                 @onmouseup="StopColumnResize"
                 @onmouseleave="StopColumnResize"></div>
        }
        @{
            var folderListItems = SortedAndFilteredItems.ToList();
        }
        @if (folderListItems.Count == 0)
        {
            <div class="folder-list-empty">
                <span>@(HasActiveFilters ? UserMessages.FolderListEmptyFiltered : UserMessages.FolderListEmpty)</span>
            </div>
        }
        else
        {
            <table @ref="_tableRef" class="folder-table folder-table--two-col @(_isColumnResizing ? "folder-table--resizing" : null)">
                <colgroup>
                    @if (_columnLayoutInitialized)
                    {
                        <col style="width: @($"{_colNameWidth}px")" />
                        <col style="width: @($"{GetColDateWidth()}px")" />
                    }
                    else
                    {
                        <col />
                        <col style="width: @($"{FolderTableColumnLayout.ColDateDefault}px")" />
                    }
                </colgroup>
                <thead>
                    <tr>
                        <th class="col-name sortable @(SortColumn == "name" ? "sorted" : "")" @onclick='() => OnSort.InvokeAsync("name")'>
                            <span class="col-header-label">@UserMessages.ColumnName @GetSortIcon("name")</span>
                            <span class="folder-col-resize-handle @GetColumnResizeActiveClass()"
                                  title="@UserMessages.ColumnResizeHandleTitle"
                                  @onmousedown="@(e => StartColumnResizeAsync(e))"
                                  @onmousedown:preventDefault="true"
                                  @onmousedown:stopPropagation="true"
                                  @onclick:stopPropagation="true"></span>
                        </th>
                        <th class="col-date sortable @(SortColumn == "date" ? "sorted" : "")" @onclick='() => OnSort.InvokeAsync("date")'>
                            <span class="col-header-label">@UserMessages.ColumnDate @GetSortIcon("date")</span>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < folderListItems.Count; i++)
                    {
                        var item = folderListItems[i];
                        var display = GetDisplayParts(item);
                        var iconClass = GetFileIconClass?.Invoke(item.Name) ?? "text";
                        var isSelected = SelectedRowIndex >= 0 && SelectedRowIndex == i;
                        <tr class="folder-row @(isSelected ? "folder-row--selected" : null)"
                            data-row-index="@i"
                            @onclick="async () => { await OnRowClick.InvokeAsync(item); }">
                            <td class="col-name">
                                <span class="col-name-cell">
                                    <svg class="item-icon file @iconClass" viewBox="0 0 16 16" fill="currentColor"><path d="M2 1.75C2 .784 2.784 0 3.75 0h6.586c.464 0 .909.184 1.237.513l2.914 2.914c.329.328.513.773.513 1.237v9.586A1.75 1.75 0 0 1 13.25 16h-9.5A1.75 1.75 0 0 1 2 14.25Zm1.75-.25a.25.25 0 0 0-.25.25v12.5c0 .138.112.25.25.25h9.5a.25.25 0 0 0 .25-.25V6h-2.75A1.75 1.75 0 0 1 9 4.25V1.5Zm6.75.062V4.25c0 .138.112.25.25.25h2.688l-.011-.013-2.914-2.914-.013-.011Z"/></svg>
                                    <span class="item-name-line" title="@GetDisplayTitle(item)">
                                        @if (display.FolderPrefix != null)
                                        {
                                            <span class="item-path-prefix">@display.FolderPrefix@FolderListDisplay.DisplaySeparator</span>
                                        }
                                        <span class="item-name">@display.FileName</span>
                                    </span>
                                </span>
                            </td>
                            <td class="col-date">@(item.LastModified.HasValue ? DisplayFormatters.FormatDate(item.LastModified.Value) : "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
}

@code {
    [Parameter] public TreeNode? SelectedFolder { get; set; }
    [Parameter] public IEnumerable<TreeNode> SortedAndFilteredItems { get; set; } = Enumerable.Empty<TreeNode>();
    [Parameter] public IEnumerable<TreeNode> AllFileItems { get; set; } = Enumerable.Empty<TreeNode>();
    [Parameter] public int TotalFileCount { get; set; }
    [Parameter] public int FilteredFileCount { get; set; }
    [Parameter] public int SelectedRowIndex { get; set; } = -1;
    [Parameter] public string FileSearchQuery { get; set; } = "";
    [Parameter] public EventCallback<string> FileSearchQueryChanged { get; set; }
    [Parameter] public string SortColumn { get; set; } = "name";
    [Parameter] public bool SortAscending { get; set; } = true;
    [Parameter] public string FilterType { get; set; } = "";
    [Parameter] public bool ShowFilterMenu { get; set; }
    [Parameter] public int ScrollToRowIndex { get; set; } = -1;
    [Parameter] public EventCallback OnScrollToRowCompleted { get; set; }
    [Parameter] public EventCallback<string> OnSort { get; set; }
    [Parameter] public EventCallback OnToggleFilterMenu { get; set; }
    [Parameter] public EventCallback OnCloseFilterMenu { get; set; }
    [Parameter] public EventCallback<string> OnFilter { get; set; }
    [Parameter] public EventCallback<TreeNode> OnRowClick { get; set; }
    [Parameter] public EventCallback<TreeNode> OnNavigateToFolder { get; set; }
    [Parameter] public Func<string, string>? GetFileIconClass { get; set; }

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(FileSearchQuery) || !string.IsNullOrEmpty(FilterType);

    private string FileSearchQueryValue
    {
        get => FileSearchQuery;
        set => _ = FileSearchQueryChanged.InvokeAsync(value);
    }

    private ElementReference _tableRef;
    private int _tableWidth;
    private int _lastMeasuredTableWidth;
    private int _colNameWidth = FolderTableColumnLayout.ColMinName;
    private int _colDateWidth = FolderTableColumnLayout.ColDateDefault;
    private bool _columnLayoutInitialized;
    private bool _isColumnResizing;
    private double _columnResizeStartX;
    private int _columnResizeStartName;
    private int _columnResizeStartDate;
    private int _lastScrolledRow = -1;

    private List<TreeNode> GetBreadcrumb()
    {
        var list = new List<TreeNode>();
        for (var node = SelectedFolder; node != null; node = node.Parent)
            list.Add(node);
        list.Reverse();
        return list;
    }

    private FolderListDisplay.FileDisplayParts GetDisplayParts(TreeNode item) =>
        FolderListDisplay.FormatFileDisplay(SelectedFolder?.FullPath ?? "", item.FilePath, item.Name);

    private static string GetDisplayTitle(TreeNode item) =>
        FolderListDisplay.NormalizeDisplayPath(item.FilePath);

    private IEnumerable<string> GetUniqueExtensions()
    {
        return AllFileItems
            .Where(i => !string.IsNullOrEmpty(Path.GetExtension(i.Name)))
            .Select(i => Path.GetExtension(i.Name).ToLowerInvariant())
            .Distinct()
            .OrderBy(e => e);
    }

    private MarkupString GetSortIcon(string column)
    {
        if (SortColumn != column)
            return new MarkupString("");
        return new MarkupString(SortAscending
            ? "<svg class='sort-icon' viewBox='0 0 16 16' fill='currentColor'><path d='m4.427 7.427 3.396 3.396a.25.25 0 0 0 .354 0l3.396-3.396A.25.25 0 0 0 11.396 7H4.604a.25.25 0 0 0-.177.427Z'/></svg>"
            : "<svg class='sort-icon' viewBox='0 0 16 16' fill='currentColor'><path d='m4.427 9.573 3.396-3.396a.25.25 0 0 1 .354 0l3.396 3.396a.25.25 0 0 1-.177.427H4.604a.25.25 0 0 1-.177-.427Z'/></svg>");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (SelectedFolder == null)
            return;

        if (SortedAndFilteredItems.Any())
        {
            await RefreshTableWidthAsync();
            if (_tableWidth > 0)
            {
                var changed = false;
                if (!_columnLayoutInitialized)
                {
                    var initial = FolderTableColumnLayout.CreateInitialTwoColumn(_tableWidth);
                    _colNameWidth = initial.Name;
                    _colDateWidth = initial.Date;
                    _columnLayoutInitialized = true;
                    changed = true;
                }
                else if (_tableWidth != _lastMeasuredTableWidth)
                {
                    ApplyFitToTable(absorbSlackIntoName: true);
                    changed = true;
                }

                _lastMeasuredTableWidth = _tableWidth;
                if (changed)
                    StateHasChanged();
            }
        }

        if (ScrollToRowIndex >= 0 && ScrollToRowIndex != _lastScrolledRow)
        {
            try
            {
                await Js.InvokeVoidAsync("scrollFolderListRowIntoView", ScrollToRowIndex);
                _lastScrolledRow = ScrollToRowIndex;
                await OnScrollToRowCompleted.InvokeAsync();
            }
            catch (JSException)
            {
                // WebView 未準備
            }
        }
    }

    protected override void OnParametersSet()
    {
        if (ScrollToRowIndex < 0)
            _lastScrolledRow = -1;
    }

    private void ApplyFitToTable(bool absorbSlackIntoName)
    {
        var fit = FolderTableColumnLayout.FitToTableTwoColumn(
            _tableWidth, _colNameWidth, _colDateWidth, absorbSlackIntoName);
        _colNameWidth = fit.Name;
        _colDateWidth = fit.Date;
    }

    private async Task EnsureColumnLayoutReadyAsync()
    {
        if (_columnLayoutInitialized && _tableWidth > 0)
            return;

        await RefreshTableWidthAsync();
        if (_tableWidth <= 0)
            return;

        if (!_columnLayoutInitialized)
        {
            var initial = FolderTableColumnLayout.CreateInitialTwoColumn(_tableWidth);
            _colNameWidth = initial.Name;
            _colDateWidth = initial.Date;
            _columnLayoutInitialized = true;
            _lastMeasuredTableWidth = _tableWidth;
        }
    }

    private async Task RefreshTableWidthAsync()
    {
        try
        {
            _tableWidth = await Js.InvokeAsync<int>("getElementClientWidth", _tableRef).ConfigureAwait(false);
        }
        catch (JSException)
        {
            _tableWidth = 0;
        }
    }

    private async Task StartColumnResizeAsync(MouseEventArgs e)
    {
        _isColumnResizing = true;
        _columnResizeStartX = e.ClientX;

        await EnsureColumnLayoutReadyAsync();
        ApplyFitToTable(absorbSlackIntoName: false);

        _columnResizeStartName = _colNameWidth;
        _columnResizeStartDate = _colDateWidth;
        StateHasChanged();
    }

    private void OnColumnResize(MouseEventArgs e)
    {
        if (!_isColumnResizing)
            return;

        var delta = (int)(e.ClientX - _columnResizeStartX);
        var (name, date) = FolderTableColumnLayout.ResizeAdjacent(
            _columnResizeStartName, _columnResizeStartDate, delta,
            FolderTableColumnLayout.ColMinName, FolderTableColumnLayout.ColMinDate,
            FolderTableColumnLayout.ColMaxDate);
        _colNameWidth = name;
        _colDateWidth = date;
        StateHasChanged();
    }

    private void StopColumnResize(MouseEventArgs _)
    {
        if (!_isColumnResizing)
            return;
        _isColumnResizing = false;
        StateHasChanged();
    }

    private int GetColDateWidth() => _colDateWidth;

    private string? GetColumnResizeActiveClass() =>
        _isColumnResizing ? "folder-col-resize-handle--active" : null;

    private Task CloseFilterMenu() => OnCloseFilterMenu.InvokeAsync();
}
