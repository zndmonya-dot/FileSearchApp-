@namespace FileSearch.Blazor.Components.Shared
@implements IDisposable
@*
  右ペインのファイルヘッダ・プレビュー本文（WinMerge 風: 行番号 + 等幅）。
  本文は Blazor 経由で描画せず JS（preview.js）が DOM を直接構築する（WebView 安定性）。
*@
@using FullTextSearch.Core.Models
@inject FileSearch.Blazor.Services.PreviewJsInterop PreviewJs
@if (SelectedFile != null)
{
<div class="file-box">
    <div class="file-header">
        <span class="file-icon @((GetFileIconClass?.Invoke(SelectedFile.FileName)) ?? "text")">
            <svg viewBox="0 0 16 16" fill="currentColor"><path d="M2 1.75C2 .784 2.784 0 3.75 0h6.586c.464 0 .909.184 1.237.513l2.914 2.914c.329.328.513.773.513 1.237v9.586A1.75 1.75 0 0 1 13.25 16h-9.5A1.75 1.75 0 0 1 2 14.25Zm1.75-.25a.25.25 0 0 0-.25.25v12.5c0 .138.112.25.25.25h9.5a.25.25 0 0 0 .25-.25V6h-2.75A1.75 1.75 0 0 1 9 4.25V1.5Zm6.75.062V4.25c0 .138.112.25.25.25h2.688l-.011-.013-2.914-2.914-.013-.011Z"/></svg>
        </span>
        <div class="file-info">
            <span class="file-name">@SelectedFile.FileName</span>
            @if (FolderPathSegments.Count > 0)
            {
                <nav class="folder-breadcrumb file-path-breadcrumb-nav" aria-label="@UserMessages.PreviewFolderPathLabel">
                    @foreach (var (segment, index) in FolderPathSegments.Select((s, i) => (s, i)))
                    {
                        @if (index > 0)
                        {
                            <span class="folder-breadcrumb-sep" aria-hidden="true">/</span>
                        }
                        <button type="button"
                                class="folder-breadcrumb-link"
                                title="@segment.FullPath"
                                @onclick="() => OnNavigateToFolderPath.InvokeAsync(segment.FullPath)">
                            @segment.DisplayName
                        </button>
                    }
                </nav>
            }
        </div>
        <div class="preview-toolbar">
            @if (ShowNavButtons)
            {
                <div class="preview-toolbar-segment preview-toolbar-nav" role="group" aria-label="@UserMessages.PreviewNavGroupLabel">
                    <button type="button" class="toolbar-btn toolbar-btn-icon" @onclick="OnGoPrev" title="@UserMessages.PreviewGoPrevTitle" aria-label="@UserMessages.PreviewGoPrevTitle">
                        <svg class="toolbar-nav-chevron" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 3.75 13 11.5h-2.25L8 7.25 5.25 11.5H3L8 3.75Z"/></svg>
                    </button>
                    <button type="button" class="toolbar-btn toolbar-btn-icon" @onclick="OnGoNext" title="@UserMessages.PreviewGoNextTitle" aria-label="@UserMessages.PreviewGoNextTitle">
                        <svg class="toolbar-nav-chevron toolbar-nav-chevron-down" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 3.75 13 11.5h-2.25L8 7.25 5.25 11.5H3L8 3.75Z"/></svg>
                    </button>
                </div>
            }
            <div class="preview-toolbar-segment preview-toolbar-open" role="group" aria-label="@UserMessages.PreviewOpenGroupLabel">
                <button type="button" class="toolbar-btn" @onclick="OnOpenFile" title="@UserMessages.OpenFileTitle">
                    <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M2 1.75C2 .784 2.784 0 3.75 0h6.586c.464 0 .909.184 1.237.513l2.914 2.914c.329.328.513.773.513 1.237v9.586A1.75 1.75 0 0 1 13.25 16h-9.5A1.75 1.75 0 0 1 2 14.25Zm1.75-.25a.25.25 0 0 0-.25.25v12.5c0 .138.112.25.25.25h9.5a.25.25 0 0 0 .25-.25V6h-2.75A1.75 1.75 0 0 1 9 4.25V1.5Zm6.75.062V4.25c0 .138.112.25.25.25h2.688l-.011-.013-2.914-2.914-.013-.011Z"/></svg>
                    <span>@UserMessages.OpenFile</span>
                </button>
                <button type="button" class="toolbar-btn" @onclick="OnOpenFolder" title="@UserMessages.OpenFolderTitle">
                    <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M.513 1.513A1.75 1.75 0 0 1 1.75 1h3.5c.55 0 1.07.26 1.4.7l.9 1.2a.25.25 0 0 0 .2.1H13a1 1 0 0 1 1 1v.5H2.75a.75.75 0 0 0 0 1.5h11.978a1 1 0 0 1 .994 1.117L15 13.25A1.75 1.75 0 0 1 13.25 15H1.75A1.75 1.75 0 0 1 0 13.25V2.75c0-.464.184-.91.513-1.237Z"/></svg>
                    <span>@UserMessages.OpenFolderShort</span>
                </button>
            </div>
        </div>
    </div>

    <div class="preview-zoom-wrap @(IsLoadingPreview ? "is-rendering" : null)">
        <div class="loading-state loading-state-cute" style="@(IsLoadingPreview ? null : "display:none")" aria-busy="@IsLoadingPreview" aria-live="polite">
            <CuteLoader Size="lg" />
        </div>
        <div class="code-view" id="preview-code-view"></div>
    </div>
</div>
}

@code {
    [Parameter] public SearchResultItem? SelectedFile { get; set; }
    [Parameter] public IReadOnlyList<(string FullPath, string DisplayName)> FolderPathSegments { get; set; } = Array.Empty<(string, string)>();
    [Parameter] public bool IsLoadingPreview { get; set; }
    [Parameter] public PreviewResult? Preview { get; set; }
    [Parameter] public bool ShowNavButtons { get; set; }
    [Parameter] public EventCallback OnGoPrev { get; set; }
    [Parameter] public EventCallback OnGoNext { get; set; }
    [Parameter] public EventCallback OnOpenFile { get; set; }
    [Parameter] public EventCallback OnOpenFolder { get; set; }
    [Parameter] public EventCallback<string> OnNavigateToFolderPath { get; set; }
    [Parameter] public Func<string, string>? GetFileIconClass { get; set; }
    [Parameter] public EventCallback<string?> OnPreviewRendered { get; set; }

    private string _renderKey = "";
    private CancellationTokenSource? _renderCts;

    protected override void OnParametersSet()
    {
        if (IsLoadingPreview)
            _renderKey = "";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (SelectedFile == null || Preview == null)
            return;

        var preview = Preview;
        var key = $"{SelectedFile.FilePath}|{preview.Content.Length}|{preview.IsError}|{preview.LineCount}|{string.Join('\u001f', preview.SearchTerms)}|{string.Join(',', preview.MatchLineNumbers)}";
        if (key == _renderKey)
            return;
        _renderKey = key;

        _renderCts?.Cancel();
        _renderCts?.Dispose();
        _renderCts = new CancellationTokenSource();
        var token = _renderCts.Token;

        try
        {
            var scrollResult = await PreviewJs.RenderAsync(preview, token);
            if (!token.IsCancellationRequested)
                await OnPreviewRendered.InvokeAsync(scrollResult);
        }
        catch (OperationCanceledException)
        {
            /* 新しいプレビュー要求でキャンセル */
        }
        catch (Exception ex)
        {
            PreviewJs.LogInteropFailure("RenderAsync", ex);
            if (!token.IsCancellationRequested)
                await OnPreviewRendered.InvokeAsync(null);
        }
    }

    public void Dispose()
    {
        _renderCts?.Cancel();
        _renderCts?.Dispose();
    }
}
