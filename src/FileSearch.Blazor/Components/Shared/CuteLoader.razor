@namespace FileSearch.Blazor.Components.Shared
@*
  GitHub 風 3 ドットローダー（文言なし・アニメーションのみ）。
  Size: sm / md / lg
*@
@if (Decorative)
{
    <div class="@CssClass" aria-hidden="true">
        <div class="cute-loader__dots">
            <span class="cute-loader__dot"></span>
            <span class="cute-loader__dot"></span>
            <span class="cute-loader__dot"></span>
        </div>
    </div>
}
else
{
    <div class="@CssClass" role="status" aria-label="@EffectiveAriaLabel" aria-busy="true">
        <div class="cute-loader__dots" aria-hidden="true">
            <span class="cute-loader__dot"></span>
            <span class="cute-loader__dot"></span>
            <span class="cute-loader__dot"></span>
        </div>
    </div>
}

@code {
    [Parameter] public string Size { get; set; } = "md";
    /// <summary>スクリーンリーダー用（画面上には表示しない）。</summary>
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public bool Decorative { get; set; }

    private string CssClass => Size?.ToLowerInvariant() switch
    {
        "sm" => "cute-loader cute-loader--sm",
        "lg" => "cute-loader cute-loader--lg",
        _ => "cute-loader cute-loader--md"
    };

    private string EffectiveAriaLabel => AriaLabel ?? UserMessages.PreviewLoading;
}
