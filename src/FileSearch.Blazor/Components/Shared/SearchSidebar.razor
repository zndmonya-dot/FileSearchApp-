@namespace FileSearch.Blazor.Components.Shared
@*
  左サイドバー: 検索入力・結果ツリー・インデックス進捗/登録件数フッター・幅リサイズ。
  親は Home。文言は UserMessages。
*@
@using FileSearch.Blazor.Components.Shared
@using FullTextSearch.Core.Search
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components
<aside class="sidebar @(IsIndexing ? "sidebar--locked" : null)" style="width: @(SidebarWidth)px">
    <div class="sidebar-header">
        <span class="sidebar-title">
            <svg viewBox="0 0 16 16" fill="currentColor"><path d="M.513 1.513A1.75 1.75 0 0 1 1.75 1h3.5c.55 0 1.07.26 1.4.7l.9 1.2a.25.25 0 0 0 .2.1H13a1 1 0 0 1 1 1v.5H2.75a.75.75 0 0 0 0 1.5h11.978a1 1 0 0 1 .994 1.117L15 13.25A1.75 1.75 0 0 1 13.25 15H1.75A1.75 1.75 0 0 1 0 13.25V2.75c0-.464.184-.91.513-1.237Z"/></svg>
            @(IsBrowseMode ? UserMessages.SidebarTitleFiles : UserMessages.SidebarTitleSearchResults)
        </span>
        <div class="sidebar-header-actions">
            @if (!IsBrowseMode || TotalFileCount > 0)
            {
            @* M-04 検索結果件数 *@
            <span class="sidebar-badge">@TotalFileCount</span>
            }
            @* M-02 設定ボタン *@
            <button type="button" class="sidebar-settings-btn" disabled="@IsIndexing" @onclick="OnOpenSettings" title="@UserMessages.SettingsTitle">
                <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0a8.2 8.2 0 0 1 .701.031C9.444.095 9.99.645 10.16 1.29l.288 1.107c.018.066.079.158.212.224.231.114.454.243.668.386.123.082.233.09.299.071l1.103-.303c.644-.176 1.392.021 1.82.63.27.385.506.792.704 1.218.315.675.111 1.422-.364 1.891l-.814.806c-.049.048-.098.147-.088.294.016.257.016.515 0 .772-.01.147.039.246.088.294l.814.806c.475.469.679 1.216.364 1.891a7.977 7.977 0 0 1-.704 1.217c-.428.61-1.176.807-1.82.63l-1.102-.302c-.067-.019-.177-.011-.3.071a5.909 5.909 0 0 1-.668.386c-.133.066-.194.158-.211.224l-.29 1.106c-.168.646-.715 1.196-1.458 1.26a8.006 8.006 0 0 1-1.402 0c-.743-.064-1.289-.614-1.458-1.26l-.289-1.106c-.018-.066-.079-.158-.212-.224a5.738 5.738 0 0 1-.668-.386c-.123-.082-.233-.09-.299-.071l-1.103.303c-.644.176-1.392-.021-1.82-.63a8.12 8.12 0 0 1-.704-1.218c-.315-.675-.111-1.422.363-1.891l.815-.806c.049-.048.098-.147.088-.294a6.214 6.214 0 0 1 0-.772c.01-.147-.039-.246-.088-.294l-.815-.806C.635 6.045.431 5.298.746 4.623a7.92 7.92 0 0 1 .704-1.217c.428-.61 1.176-.807 1.82-.63l1.102.302c.067.019.177.011.3-.071.214-.143.437-.272.668-.386.133-.066.194-.158.211-.224l.29-1.106C6.009.645 6.556.095 7.299.03 7.53.01 7.764 0 8 0Zm-.571 1.525c-.036.003-.108.036-.137.146l-.289 1.105c-.147.561-.549.967-.998 1.189-.173.086-.34.183-.5.29-.417.278-.97.423-1.529.27l-1.103-.303c-.109-.03-.175.016-.195.045-.22.312-.412.644-.573.99-.014.031-.021.11.059.19l.815.806c.411.406.562.957.53 1.456a4.709 4.709 0 0 0 0 .582c.032.499-.119 1.05-.53 1.456l-.815.806c-.081.08-.073.159-.059.19.162.346.353.677.573.989.02.03.085.076.195.046l1.102-.303c.56-.153 1.113-.008 1.53.27.161.107.328.204.501.29.447.222.85.629.997 1.189l.289 1.105c.029.109.101.143.137.146a6.6 6.6 0 0 0 1.142 0c.036-.003.108-.036.137-.146l.289-1.105c.147-.561.549-.967.998-1.189.173-.086.34-.183.5-.29.417-.278.97-.423 1.529-.27l1.103.303c.109.029.175-.016.195-.045.22-.313.411-.644.573-.99.014-.031.021-.11-.059-.19l-.815-.806c-.411-.406-.562-.957-.53-1.456a4.709 4.709 0 0 0 0-.582c-.032-.499.119-1.05.53-1.456l.815-.806c.081-.08.073-.159.059-.19a6.464 6.464 0 0 0-.573-.989c-.02-.03-.085-.076-.195-.046l-1.102.303c-.56.153-1.113.008-1.53-.27a4.44 4.44 0 0 0-.501-.29c-.447-.222-.85-.629-.997-1.189l-.289-1.105c-.029-.11-.101-.143-.137-.146a6.6 6.6 0 0 0-1.142 0ZM11 8a3 3 0 1 1-6 0 3 3 0 0 1 6 0ZM9.5 8a1.5 1.5 0 1 0-3.001.001A1.5 1.5 0 0 0 9.5 8Z"/></svg>
            </button>
        </div>
    </div>

    @* M-03 検索入力欄（検索ボタン／Enter で検索、Esc でクリア） *@
    <div class="sidebar-search-wrap">
        <div class="search-mode-group" role="radiogroup" aria-label="@UserMessages.SearchModeGroupLabel">
            @{
                var modeDisabled = IsIndexing;
            }
            <label class="search-mode-option @(modeDisabled ? "search-mode-option--disabled" : null)" title="@UserMessages.SearchModeKeywordTitle">
                <input type="radio" name="search-mode" checked="@(SearchMode == SearchMode.Keyword)" disabled="@modeDisabled" @onchange="@SelectKeywordMode" />
                <span>@UserMessages.SearchModeKeyword</span>
            </label>
            <label class="search-mode-option @(modeDisabled ? "search-mode-option--disabled" : null)" title="@UserMessages.SearchModeAnyTitle">
                <input type="radio" name="search-mode" checked="@(SearchMode == SearchMode.Any)" disabled="@modeDisabled" @onchange="@SelectAnyMode" />
                <span>@UserMessages.SearchModeAny</span>
            </label>
            <label class="search-mode-option @(modeDisabled ? "search-mode-option--disabled" : null)" title="@UserMessages.SearchModePhraseTitle">
                <input type="radio" name="search-mode" checked="@(SearchMode == SearchMode.Phrase)" disabled="@modeDisabled" @onchange="@SelectPhraseMode" />
                <span>@UserMessages.SearchModePhrase</span>
            </label>
        </div>
        <div class="sidebar-search-row">
            <div class="sidebar-search">
                <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M10.68 11.74a6 6 0 0 1-7.922-8.982 6 6 0 0 1 8.982 7.922l3.04 3.04a.749.749 0 0 1-.326 1.275.749.749 0 0 1-.734-.215ZM11.5 7a4.499 4.499 0 1 0-8.997 0A4.499 4.499 0 0 0 11.5 7Z"/></svg>
                <input id="search-input" type="text" placeholder="@UserMessages.SearchInputPlaceholder" value="@SearchQuery" @oninput="HandleSearchInput" @onkeydown="OnSearchKeyDown" disabled="@IsIndexing" tabindex="0" autofocus />
            </div>
            <button type="button"
                    class="sidebar-search-btn"
                    @onclick="OnSearchClick"
                    disabled="@(!CanSearch)"
                    title="@UserMessages.SearchButtonTitle">
                @UserMessages.SearchButtonLabel
            </button>
        </div>
    </div>
    @if (IsIndexing)
    {
        <div class="sidebar-notice">
            <span>@UserMessages.CannotSearchWhileIndexing</span>
        </div>
    }
    @if (!string.IsNullOrEmpty(SearchErrorMessage))
    {
        <div class="error-banner search-error">
            <span>@SearchErrorMessage</span>
        </div>
    }
    @* M-05 検索結果表示領域（ツリー）／ M-06 状態表示（検索中・キーワード未入力・結果なし等） *@
    <div class="sidebar-content" id="tree-list">
        @if (IsSearching)
        {
            @* M-06 検索実行中（Enter・検索ボタン・AND/OR 切替で共通） *@
            <div class="tree-status tree-status-cute" aria-busy="true" aria-live="polite">
                <CuteLoader Size="md" AriaLabel="@UserMessages.Searching" />
            </div>
        }
        else if (TreeNodes.Count > 0)
        {
            @* M-05 検索結果／フォルダツリー *@
            <SearchResultTree Nodes="TreeNodes"
                             CurrentPreviewFilePath="@CurrentPreviewFilePath"
                             CurrentFolderPath="@CurrentFolderPath"
                             OnToggleNode="OnToggleNode"
                             OnSelectFile="OnSelectFile"
                             GetFileIconClass="GetFileIconClass" />
        }
        else if (IsLoadingFolderTree)
        {
            <div class="tree-status tree-status-folder-loading" aria-busy="true" aria-live="polite" aria-label="@UserMessages.FolderTreeLoading">
                <TreeSkeleton />
            </div>
        }
        else
        {
            @* M-06 キーワード未入力／未検索／結果 0 件 *@
            <div class="tree-status tree-status-blankslate">
                <span>@GetEmptyTreeMessage()</span>
            </div>
        }
    </div>

    <div class="sidebar-footer">
        @if (IsIndexing)
        {
            @* M-15 進捗状況表示 / I-06 処理済みファイル数・I-07 総ファイル数・I-08 現在処理中のファイル名（実装は本フッターに統合） *@
            <div class="footer-status building">
                <div class="footer-row">
                    <div class="footer-icon footer-icon--loading footer-icon--spin">
                        <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M1.705 8.005a.75.75 0 0 1 .834.656 5.5 5.5 0 0 0 9.592 2.97l-1.204-1.204a.25.25 0 0 1 .177-.427h3.646a.25.25 0 0 1 .25.25v3.646a.25.25 0 0 1-.427.177l-1.38-1.38A7.002 7.002 0 0 1 1.05 8.84a.75.75 0 0 1 .656-.834ZM8 2.5a5.487 5.487 0 0 0-4.131 1.869l1.204 1.204A.25.25 0 0 1 4.896 6H1.25A1.75 1.75 0 0 1 1 5.75V2.104a.25.25 0 0 1 .427-.177l1.38 1.38A7.002 7.002 0 0 1 14.95 7.16a.75.75 0 0 1-1.49.178A5.5 5.5 0 0 0 8 2.5Z"/></svg>
                    </div>
                    <div class="footer-text">
                        <span class="footer-primary">@UserMessages.FormatBuildingPercent(IndexProgressPercent)</span>
                        <span class="footer-secondary footer-secondary-building" title="@IndexProgressText">@IndexProgressText</span>
                    </div>
                    @* M-16 キャンセルボタン（更新中） *@
                    <button type="button" class="footer-action footer-cancel" @onclick="OnCancelIndexBuild" title="@UserMessages.IndexBuildCancelTitle">@UserMessages.Cancel</button>
                </div>
                <div class="footer-progress">
                    <div class="footer-progress-bar" style="width: @(IndexProgressPercent)%"></div>
                </div>
            </div>
        }
        else if (!string.IsNullOrEmpty(IndexErrorMessage))
        {
            <div class="footer-status error">
                <p class="footer-error-text">@IndexErrorMessage</p>
                @if (IsAdmin)
                {
                    <button type="button" class="footer-error-action" @onclick="OnOpenSettings">@UserMessages.OpenSettingsFromIndexError</button>
                }
            </div>
        }
        else
        {
            <div class="footer-status">
                <div class="footer-row footer-row-idle">
                    <div class="footer-icon">
                        <svg viewBox="0 0 16 16" fill="currentColor"><path d="M0 1.75A.75.75 0 0 1 .75 1h4.253c1.227 0 2.317.59 3 1.501A3.743 3.743 0 0 1 11.006 1h4.245a.75.75 0 0 1 .75.75v10.5a.75.75 0 0 1-.75.75h-4.507a2.25 2.25 0 0 0-1.591.659l-.622.621a.75.75 0 0 1-1.06 0l-.622-.621A2.25 2.25 0 0 0 5.258 13H.75a.75.75 0 0 1-.75-.75Zm7.251 10.324.004-5.073-.002-2.253A2.25 2.25 0 0 0 5.003 2.5H1.5v9h3.757a3.75 3.75 0 0 1 1.994.574ZM8.755 4.75l-.004 7.322a3.752 3.752 0 0 1 1.992-.572H14.5v-9h-3.495a2.25 2.25 0 0 0-2.25 2.25Z"/></svg>
                    </div>
                    <div class="footer-main-block">
                        <div class="footer-line-with-action">
                            <div class="footer-headlines">
                                <span class="footer-primary">@UserMessages.FormatRegisteredCount(IndexCount)</span>
                                @* M-13 インデックス最終更新日時 *@
                                <span class="footer-secondary">@GetLastUpdateText()@UserMessages.LastUpdateSuffix</span>
                            </div>
                            @* M-14 再構築ボタン（押下で SCR-3 を表示）。非管理者は参照専用のため非活性 *@
                            <button type="button" class="footer-action footer-action-with-label" @onclick="OnRequestRebuildIndex" disabled="@(!IsAdmin)" title="@(IsAdmin ? UserMessages.RebuildButtonTitle : UserMessages.RebuildButtonDisabledTitle)">
                                <svg viewBox="0 0 16 16" fill="currentColor"><path d="M1.705 8.005a.75.75 0 0 1 .834.656 5.5 5.5 0 0 0 9.592 2.97l-1.204-1.204a.25.25 0 0 1 .177-.427h3.646a.25.25 0 0 1 .25.25v3.646a.25.25 0 0 1-.427.177l-1.38-1.38A7.002 7.002 0 0 1 1.05 8.84a.75.75 0 0 1 .656-.834ZM8 2.5a5.487 5.487 0 0 0-4.131 1.869l1.204 1.204A.25.25 0 0 1 4.896 6H1.25A1.75 1.75 0 0 1 1 5.75V2.104a.25.25 0 0 1 .427-.177l1.38 1.38A7.002 7.002 0 0 1 14.95 7.16a.75.75 0 0 1-1.49.178A5.5 5.5 0 0 0 8 2.5Z"/></svg>
                                <span class="footer-action-label">@UserMessages.Rebuild</span>
                            </button>
                        </div>
                        @if (IndexSkipCount > 0)
                        {
                            @* M-17 スキップ警告 / I-09 スキップ数（クリックで skipped_files.log を開く） *@
                            <div class="footer-skip-wrap">
                                <button type="button"
                                        class="footer-skip-line"
                                        @onclick="OnOpenSkippedLogAsync"
                                        title="@UserMessages.SkippedLogOpenTooltip(DefaultPaths.SkippedFilesLogFileName)">
                                    @UserMessages.FormatSkippedCountLine(IndexSkipCount)
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="resize-handle" @onmousedown="OnStartResize"></div>
</aside>

@code {
    /// <summary>サイドバー幅（px）。</summary>
    [Parameter] public int SidebarWidth { get; set; }
    /// <summary>検索ボックスの現在値。</summary>
    [Parameter] public string SearchQuery { get; set; } = "";
    /// <summary>検索文字列の双方向バインド用。</summary>
    [Parameter] public EventCallback<string> SearchQueryChanged { get; set; }
    /// <summary>検索モード。</summary>
    [Parameter] public SearchMode SearchMode { get; set; } = SearchMode.Keyword;
    /// <summary>検索モード変更。</summary>
    [Parameter] public EventCallback<SearchMode> SearchModeChanged { get; set; }
    /// <summary>ヒット件数（バッジ表示）。</summary>
    [Parameter] public int TotalFileCount { get; set; }
    /// <summary>ツリーに渡すルートノード一覧。</summary>
    [Parameter] public IReadOnlyList<TreeNode> TreeNodes { get; set; } = Array.Empty<TreeNode>();
    /// <summary>検索実行中（スピナー表示）。</summary>
    [Parameter] public bool IsSearching { get; set; }
    /// <summary>検索エラーメッセージ（あればバナー）。</summary>
    [Parameter] public string? SearchErrorMessage { get; set; }
    /// <summary>インデックス構築中（検索無効・進捗表示）。</summary>
    [Parameter] public bool IsIndexing { get; set; }
    /// <summary>インデックス進捗 0〜100。</summary>
    [Parameter] public int IndexProgressPercent { get; set; }
    /// <summary>進捗の補足テキスト（ツールチップ等）。</summary>
    [Parameter] public string IndexProgressText { get; set; } = "";
    /// <summary>登録ドキュメント件数。</summary>
    [Parameter] public int IndexCount { get; set; }
    /// <summary>インデックス系エラー（あればフッター赤字）。</summary>
    [Parameter] public string? IndexErrorMessage { get; set; }
    /// <summary>スキップされたファイル件数。</summary>
    [Parameter] public int IndexSkipCount { get; set; }
    /// <summary>スキップログを開く。</summary>
    [Parameter] public EventCallback OnOpenSkippedLog { get; set; }
    /// <summary>検索ボタン押下（Enter 検索と同じ）。</summary>
    [Parameter] public EventCallback OnSearch { get; set; }
    /// <summary>検索欄のキー入力（Enter 検索など）。</summary>
    [Parameter] public EventCallback<KeyboardEventArgs> OnSearchKeyDown { get; set; }
    /// <summary>検索欄の入力変更後（デバウンス用フック）。</summary>
    [Parameter] public EventCallback OnSearchInputChanged { get; set; }
    /// <summary>プレビュー中ファイルパス（ツリー強調）。</summary>
    [Parameter] public string? CurrentPreviewFilePath { get; set; }
    /// <summary>選択中フォルダパス（ツリー強調）。</summary>
    [Parameter] public string? CurrentFolderPath { get; set; }
    /// <summary>現在の入力で検索が一度でも成功済みか（空ツリー文言の切替）。</summary>
    [Parameter] public bool HasSearchedCurrentQuery { get; set; }
    /// <summary>閲覧モード（検索未実行）か。</summary>
    [Parameter] public bool IsBrowseMode { get; set; } = true;
    /// <summary>検索対象フォルダが 1 件以上設定されているか。</summary>
    [Parameter] public bool HasTargetFolders { get; set; }
    /// <summary>検索前フォルダツリーの一括読み込み中。</summary>
    [Parameter] public bool IsLoadingFolderTree { get; set; }
    /// <summary>フォルダ行クリックで展開トグル。</summary>
    [Parameter] public EventCallback<TreeNode> OnToggleNode { get; set; }
    /// <summary>ファイル行クリックで選択。</summary>
    [Parameter] public EventCallback<TreeNode> OnSelectFile { get; set; }
    /// <summary>拡張子からツリー用アイコン CSS クラスを返す。</summary>
    [Parameter] public Func<string, string>? GetFileIconClass { get; set; }
    /// <summary>インデックス再構築/更新の開始要求。</summary>
    [Parameter] public EventCallback OnRequestRebuildIndex { get; set; }
    /// <summary>インデックス構築のキャンセル。</summary>
    [Parameter] public EventCallback OnCancelIndexBuild { get; set; }
    /// <summary>右端ドラッグ開始（幅変更）。</summary>
    [Parameter] public EventCallback<MouseEventArgs> OnStartResize { get; set; }
    /// <summary>最終インデックス更新の表示用文字列（相対など）。</summary>
    [Parameter] public Func<string> GetLastUpdateText { get; set; } = () => "";
    /// <summary>実行ユーザーが管理者か。非管理者は再構築ボタンを非活性にする。</summary>
    [Parameter] public bool IsAdmin { get; set; }
    /// <summary>設定モーダルを開く（インデックスエラー時など）。</summary>
    [Parameter] public EventCallback OnOpenSettings { get; set; }

    private bool CanSearch =>
        !IsIndexing && !IsSearching && !string.IsNullOrWhiteSpace(SearchQuery);

    /// <summary>検索ボタン押下を親に伝える。</summary>
    private Task OnSearchClick() => OnSearch.InvokeAsync();

    /// <summary>検索欄入力を親に伝え、入力変更コールバックを続けて呼ぶ。</summary>
    private async Task HandleSearchInput(ChangeEventArgs e)
    {
        var v = e.Value?.ToString() ?? "";
        await SearchQueryChanged.InvokeAsync(v);
        await OnSearchInputChanged.InvokeAsync();
    }

    /// <summary>検索モードを親に伝える。</summary>
    private Task SetSearchMode(SearchMode mode)
        => SearchModeChanged.InvokeAsync(mode);

    private Task SelectKeywordMode() => SetSearchMode(SearchMode.Keyword);
    private Task SelectAnyMode() => SetSearchMode(SearchMode.Any);
    private Task SelectPhraseMode() => SetSearchMode(SearchMode.Phrase);

    /// <summary>ツリーが空のときの案内（対象フォルダ未設定／キーワード未入力／0 件）。</summary>
    private string GetEmptyTreeMessage()
    {
        if (!HasTargetFolders) return UserMessages.NoTargetFolders;
        if (IsBrowseMode) return UserMessages.TreeEmptyNoResults;
        if (string.IsNullOrWhiteSpace(SearchQuery)) return UserMessages.TreeEmptyKeywordPrompt;
        return HasSearchedCurrentQuery ? UserMessages.TreeEmptyNoResults : UserMessages.TreeEmptyPressEnterToSearch;
    }

    /// <summary>スキップログを開く（親の <c>OnOpenSkippedLog</c> を呼ぶ）。</summary>
    private Task OnOpenSkippedLogAsync()
        => OnOpenSkippedLog.InvokeAsync();
}
