{
  // ============================================================
  // 管理者 PC 用 appmode.json の例
  // 配置場所: Panoleon.exe と同じフォルダ
  // ファイル名: appmode.json（この example はコピーしてリネーム）
  // ============================================================

  // 管理者モード（再構築・設定変更が可能）
  "mode": "admin",

  // 全員が同じ UNC を指すこと（利用者 PC の appmode.json も同じパス）
  "sharedConfig": "\\\\fileserver\\panoleon\\shared.json"
}
