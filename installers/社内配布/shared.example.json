{
  // ============================================================
  // 共有設定ファイルの例（ファイルサーバ上に1つだけ置く）
  // ============================================================
  //
  // ※ 通常は手で編集しません
  //    管理者 PC で設定画面から「保存」すると自動で書き換わります
  //

  "indexPath": "\\\\fileserver\\panoleon\\index",

  "targetFolders": [
    "\\\\fileserver\\share\\documents",
    "\\\\fileserver\\share\\projects"
  ],

  // このサイズ（バイト）を超えるファイルはインデックスしない。0 = 無制限、省略 = 1MB
  "indexMaxFileBytes": 1048576
}
